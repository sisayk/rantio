# Rantio production settings. On the server this file lives at /srv/stugora/.env
# (owner root, group stugora, mode 640). It is read by:
#   - systemd (EnvironmentFile=) for gunicorn, Next.js and the timers
#   - deploy/deploy.sh and deploy/manage.sh (sourced by bash)
# so keep to plain KEY=value lines. Put a value in 'single quotes' if it contains
# spaces, $, #, < or >. Never commit the filled-in copy.
#
# NEXT_PUBLIC_* values and API_URL are built into the site by `npm run build`: after
# changing one, run deploy.sh again (it rebuilds). Other changes need only a restart:
#   systemctl restart stugora-django stugora-next

# ---------- Django core ----------
# Must be false in production.
DJANGO_DEBUG=false
# Long random string. Leave empty and setup-server.sh fills one in for you.
DJANGO_SECRET_KEY=
# Host names Django answers to (127.0.0.1/localhost for the health check on the server).
DJANGO_ALLOWED_HOSTS=rantio.fi,www.rantio.fi,127.0.0.1,localhost
# The owner dashboard posts through the site's own /api, so the site is the origin.
DJANGO_CSRF_TRUSTED_ORIGINS=https://rantio.fi,https://www.rantio.fi
# The site and API share one address in production; this only matters for other origins.
CORS_ALLOWED_ORIGINS=https://rantio.fi
# Server error (500) reports by email, comma-separated. Empty = no error emails.
DJANGO_ADMINS=CHANGE_ME@example.com
# Optional: true only once every *.rantio.fi subdomain serves HTTPS.
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_HSTS_PRELOAD=false
# DJANGO_LOG_LEVEL=INFO
# Django also sends http to https (nginx already does); false only for debugging.
# DJANGO_SECURE_SSL_REDIRECT=true

# ---------- Database and files ----------
# Local PostgreSQL over its Unix socket with peer authentication: the stugora Linux
# user logs in as the stugora database role, no password needed (setup-server.sh
# creates both). With a password instead: postgres://stugora:PASSWORD@localhost:5432/stugora
DATABASE_URL=postgres://stugora@/stugora
# Uploads (homepage slides); nginx serves this folder at /media/.
MEDIA_ROOT=/srv/stugora/media
# Django admin CSS/JS gathered by collectstatic; nginx serves it at /static/.
STATIC_ROOT=/srv/stugora/static

# ---------- Links ----------
# The public site, used in links in emails (guest conversations, the owner inbox).
SITE_URL=https://rantio.fi
# The Django admin, used in links in emails to Sisay and Juha.
ADMIN_URL=https://rantio.fi/admin

# ---------- Email (outgoing) ----------
# Django's SMTP backend. Any transactional email service with SMTP works, for
# example Postmark (smtp.postmarkapp.com, user and password = the server API token)
# or Mailgun (smtp.eu.mailgun.org, the domain's SMTP login). Verify rantio.fi with
# the service (SPF/DKIM DNS records) or mail will land in spam.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME
EMAIL_HOST_PASSWORD=CHANGE_ME
# STARTTLS on port 587. For port 465 use EMAIL_USE_SSL=true and EMAIL_USE_TLS=false.
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Seconds before giving up on the SMTP server.
# EMAIL_TIMEOUT=20
# Sender of sign-in codes, booking alerts and guest messages.
DEFAULT_FROM_EMAIL='Rantio <info@rantio.fi>'
# Sender of server error reports to DJANGO_ADMINS (defaults to DEFAULT_FROM_EMAIL).
SERVER_EMAIL='Rantio server <server@rantio.fi>'
# Who hears about new owner sign-ups and bookings (Sisay and Juha), comma-separated.
SIGNUP_NOTIFY_EMAILS=CHANGE_ME_SISAY@example.com,CHANGE_ME_JUHA@example.com
# Must be false in production: true shows the emailed sign-in code on the login page.
DEV_LOGIN_CODES=false

# ---------- AI reply suggestions (optional) ----------
# Claude suggests owners' replies in the inbox. Empty = the helper is off.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------- Booking emails (being built now) ----------
# Owners forward their Nettimökki booking emails to this address (bookings+<cottage code>@...).
BOOKING_FORWARD_ADDRESS=bookings@rantio.fi
# The mailbox those forwards land in, read every 5 minutes (manage.py read_booking_emails).
BOOKING_EMAIL_IMAP_HOST=imap.example.com
BOOKING_EMAIL_IMAP_USER=bookings@rantio.fi
BOOKING_EMAIL_IMAP_PASSWORD=CHANGE_ME
# BOOKING_EMAIL_IMAP_FOLDER=INBOX
# Shared secret for /api/inbound/booking-email/ if an inbound-email service (Mailgun,
# SendGrid) posts emails instead of IMAP. Empty = that endpoint is off.
# Make one with: openssl rand -hex 32
INBOUND_EMAIL_SECRET=
# Email owners when a booking arrives on any channel.
BOOKING_ALERTS=true

# ---------- Monthly invoices (being built now) ----------
# Stripe secret key (sk_live_...). Empty = invoices are created as drafts in the admin only.
STRIPE_SECRET_KEY=
# A 25.5 % Finnish VAT tax rate made once in the Stripe dashboard (txr_...). Empty =
# VAT goes on the invoice as its own line.
STRIPE_TAX_RATE_ID=
INVOICE_DAYS_UNTIL_DUE=14

# ---------- Error tracking (optional) ----------
# Sentry project DSN. Empty = Sentry is never loaded.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0

# ---------- Rate limits (optional; defaults shown) ----------
# SIGNUP_THROTTLE_RATE=10/hour
# LOGIN_THROTTLE_RATE=20/hour
# LOGIN_VERIFY_THROTTLE_RATE=30/hour
# ENQUIRY_THROTTLE_RATE=10/hour
# GUEST_MESSAGE_THROTTLE_RATE=60/hour
# AI_DRAFT_THROTTLE_RATE=60/hour
# Proxies in front of Django that add X-Forwarded-For (nginx = 1).
# DRF_NUM_PROXIES=1

# ---------- Next.js site ----------
# Where the site is served: canonical URLs, hreflang and sitemaps (build time).
NEXT_PUBLIC_SITE_URL=https://rantio.fi
# Where the browser sends the owner sign-up form. Same address as the site:
# nginx sends /api/ to Django (build time).
NEXT_PUBLIC_API_URL=https://rantio.fi
# Where Next.js forwards /api/* and /media/* (the rewrites in next.config.ts, fixed at
# build time). nginx answers those paths first, so this is a fallback: gunicorn here.
API_URL=http://127.0.0.1:8000
# Google Maps on the website (build time): frontend/.env.production has the key (restricted
# to rantio.fi in Google Cloud project "rantio") and the map ID. Set them here only to
# override that; an empty value here would switch the maps back to OpenStreetMap.
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# NEXT_PUBLIC_GOOGLE_MAP_ID=
# IP-to-country table for the first visit's language (deploy/geoip-update.py, daily).
# GEOIP_COUNTRY_DB=/srv/stugora/geoip/country.txt

# Owner sign-in besides the emailed code. Each one appears on the sign-in pages only when set.
# SMS code: a Brevo API key ("xkeysib-…", Brevo → SMTP & API → API keys) and SMS credits in Brevo.
# BREVO_API_KEY=
# SMS_SENDER=Rantio
# Google: the OAuth client IDs (Google Cloud → APIs & Services → Credentials), comma-separated.
# The website's one also goes in frontend/.env.production as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
# GOOGLE_CLIENT_IDS=
# Apple: the app's bundle ID and, for the website, the Services ID
# (also NEXT_PUBLIC_APPLE_SERVICES_ID in frontend/.env.production).
# APPLE_AUDIENCES=fi.rantio.app
