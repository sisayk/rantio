# Daily: fresh nightly prices to Beds24 for every cottage already there. Using the
# refresh token every day also keeps it alive (Beds24 cancels one unused for 30 days).
# Relies on the management command `beds24` (backend/owners/management/commands/).
[Unit]
Description=Rantio: send the day's prices to Beds24
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=stugora
Group=stugora
WorkingDirectory=/srv/stugora/app/backend
EnvironmentFile=/srv/stugora/.env
ExecStart=/srv/stugora/venv/bin/python manage.py beds24
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
