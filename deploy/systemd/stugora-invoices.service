# Monthly commission invoices for owners.
# Relies on the management command `make_monthly_invoices` (backend/owners/management/commands/).
# setup-server.sh / deploy.sh only enable the timer once that command exists.
[Unit]
Description=Rantio: make monthly invoices
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=stugora
Group=stugora
WorkingDirectory=/srv/stugora/app/backend
EnvironmentFile=/srv/stugora/.env
ExecStart=/srv/stugora/venv/bin/python manage.py make_monthly_invoices
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
