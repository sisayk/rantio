{
  "expo": {
    "name": "Rantio",
    "slug": "rantio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rantio",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "primaryColor": "#1d4c3c",
    "description": "Cottages across the Nordics and the Baltics, and the owner's one calendar for every booking site.",
    "ios": {
      "bundleIdentifier": "fi.rantio.app",
      "appleTeamId": "PQU74K3M7H",
      "buildNumber": "1",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "en",
          "fi",
          "sv",
          "nb",
          "nn",
          "da",
          "is",
          "et",
          "lv",
          "lt",
          "de"
        ]
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "fi.rantio.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#02503d",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1d4c3c",
          "defaultChannel": "default"
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "extraProguardRules": "# WorkManager's Room database is created by name; R8 must not strip or rename it (crash on start: Failed to create an instance of class androidx.work.impl.WorkDatabase).\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }\n-keepnames class androidx.work.impl.WorkDatabase\n-keep class androidx.work.impl.** { *; }"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Rantio uses your photos so you can add pictures of your cottage to its listing.",
          "cameraPermission": "Rantio uses the camera so you can take pictures of your cottage for its listing.",
          "microphonePermission": false
        }
      ],
      "react-native-maps",
      "expo-localization",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.42238401416-vs5r0jc5usqt7h5r8ifb5dnnqrcg9enl"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "owner": "bona.et",
    "extra": {
      "eas": {
        "projectId": "de9fff25-8c81-4b4f-8949-003b7f0b0ec9"
      },
      "googleSignInAndroid": true
    }
  }
}
