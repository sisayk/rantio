# Copy to .env to point the app at another backend while developing.
# On the iOS simulator localhost works; on the Android emulator use 10.0.2.2;
# on a phone use your Mac's address on the Wi-Fi (e.g. http://192.168.1.20:8100).
EXPO_PUBLIC_API_URL=http://localhost:8100
EXPO_PUBLIC_SITE_URL=http://localhost:3100
